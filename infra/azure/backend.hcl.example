# Copy to backend.hcl (gitignored). Fill from `terraform output backend_hcl`
# after an *approved* bootstrap apply. Never put access keys here.
#
# `key` is not interpolated from `environment`. The shared key below is OK
# only while this is the sole workload (dev0). Before a second environment,
# the key MUST include the environment slug
# (e.g. torqvoice.dev0.switzerlandnorth.tfstate) so stacks do not share one
# tfstate blob. Also env-prefix KV secret names and/or use a per-env vault.
resource_group_name  = "rg-torqvoice-tfstate"
storage_account_name = "sttorqvoicetfstateXXXX"
container_name       = "tfstate"
key                  = "torqvoice.switzerlandnorth.tfstate"
use_azuread_auth     = true
subscription_id      = "00000000-0000-0000-0000-000000000000"
