# Optional: private ghcr.io/cookieofcode/torqvoice. Do not put a
# dockerconfigjson into Terraform. Do not invent Azure ACR.
#
# Preferred for this public repo: after the first Actions push, set the
# GHCR package visibility to Public (Package settings). Then AKS pulls
# without this secret — same as any public GHCR digest.
#
# Use this path only if the package must stay private:
# 1. Create a fine-grained PAT (read:packages) or classic PAT (read:packages)
#    owned by an account that can pull cookieofcode/torqvoice. Not a long-lived
#    Azure key.
# 2. Create the Key Vault secret out-of-band (value is the JSON, not TF):
#      az keyvault secret set --vault-name "$VAULT" --name ghcr-dockerconfig \
#        --file <(kubectl create secret docker-registry ghcr-pull \
#          --docker-server=ghcr.io --docker-username=USER --docker-password=TOKEN \
#          --dry-run=client -o json | jq -r '.data[".dockerconfigjson"]' | base64 -d)
# 3. Add an ExternalSecret (or extend charts/app-secrets) that copies
#    remoteRef.key=ghcr-dockerconfig into Secret ghcr-pull (type kubernetes.io/dockerconfigjson).
# 4. Set image_pull_secret_name = "ghcr-pull" in terraform.tfvars *before*
#    the first main→dev0 CD roll (otherwise new pods cannot pull and CD
#    rolls back to the first-boot pin).
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ghcr-pull
  namespace: torqvoice
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: azure-keyvault
    kind: ClusterSecretStore
  target:
    name: ghcr-pull
    creationPolicy: Owner
    template:
      type: kubernetes.io/dockerconfigjson
      data:
        .dockerconfigjson: '{{ .dockerconfig }}'
  data:
    - secretKey: dockerconfig
      remoteRef:
        key: ghcr-dockerconfig
