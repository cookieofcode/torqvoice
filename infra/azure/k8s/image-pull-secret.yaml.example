# Optional: private GHCR. Do not put a dockerconfigjson into Terraform.
# Not needed when the package is public (bootstrap ghcr.io/torqvoice/torqvoice,
# or a public ghcr.io/cookieofcode/torqvoice after main→dev0 CD).
# 1. Create the Key Vault secret out-of-band (value is the JSON, not TF):
#      az keyvault secret set --vault-name "$VAULT" --name ghcr-dockerconfig \
#        --file <(kubectl create secret docker-registry ghcr-pull \
#          --docker-server=ghcr.io --docker-username=USER --docker-password=TOKEN \
#          --dry-run=client -o json | jq -r '.data[".dockerconfigjson"]' | base64 -d)
# 2. Add an ExternalSecret (or extend charts/app-secrets) that copies
#    remoteRef.key=ghcr-dockerconfig into Secret ghcr-pull (type kubernetes.io/dockerconfigjson).
# 3. Set image_pull_secret_name = "ghcr-pull" in terraform.tfvars.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ghcr-pull
  namespace: torqvoice
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: azure-keyvault
    kind: ClusterSecretStore
  target:
    name: ghcr-pull
    creationPolicy: Owner
    template:
      type: kubernetes.io/dockerconfigjson
      data:
        .dockerconfigjson: '{{ .dockerconfig }}'
  data:
    - secretKey: dockerconfig
      remoteRef:
        key: ghcr-dockerconfig
