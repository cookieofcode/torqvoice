# Secret values are created by Terraform (random_password / variables) and
# must never be committed. After an approved apply, inspect with:
#   terraform output -raw database_url
#   terraform output -raw better_auth_secret
#
# kubectl equivalent (only if you are not letting Terraform manage the secret):
#   kubectl create secret generic torqvoice -n torqvoice \
#     --from-literal=DATABASE_URL='postgresql://...' \
#     --from-literal=BETTER_AUTH_SECRET='...' \
#     --from-literal=NEXT_PUBLIC_APP_URL='http://...'
apiVersion: v1
kind: Secret
metadata:
  name: torqvoice
  namespace: torqvoice
  labels:
    app: torqvoice
    part-of: torqvoice
type: Opaque
stringData:
  DATABASE_URL: "REPLACE_WITH_TERRAFORM_OUTPUT_database_url"
  BETTER_AUTH_SECRET: "REPLACE_WITH_openssl_rand_hex_32_OR_TERRAFORM_OUTPUT"
  NEXT_PUBLIC_APP_URL: "http://REPLACE_WITH_PUBLIC_IP"
